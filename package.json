{
  "name": "desmistificando-ia",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:i18n": "node scripts/build-i18n.mjs",
    "build:css": "tailwindcss -i assets/css/tailwind-input.css -o assets/css/output.css --minify",
